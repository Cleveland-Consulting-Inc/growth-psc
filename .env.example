# Admin login password
ADMIN_PASSWORD=changeme

# Random 32+ character string for signing session cookies
SESSION_SECRET=replace-with-a-long-random-string

# Shared secret for the NiXI photo upload endpoint (set same value via UPLOAD_SECRET env var on the PHP host)
UPLOAD_SECRET=

# Provided automatically by Vercel when you add Postgres storage
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
